# Data source: "json" (default, bundled src/data/*.json) or "supabase".
PUBLIC_RECORD_DATA_SOURCE=json

# Required only when PUBLIC_RECORD_DATA_SOURCE=supabase (see supabase/schema.sql).
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...   # pipeline and reviewer writes only; never exposed to the browser

# Scheduled pipeline (see docs/ARCHITECTURE.md). Protects a cron route if one is added.
# CRON_SECRET=...
