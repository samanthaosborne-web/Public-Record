{
  "name": "public-record",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "data:validate": "node scripts/validate-data.cjs",
    "data:build-politicians": "node scripts/build-politicians.cjs scripts/research/2026-09-30 && node scripts/validate-data.cjs",
    "pipeline:dry-run": "tsx src/pipeline/run-daily-update.ts",
    "pipeline": "tsx src/pipeline/run-daily-update.ts --live",
    "static:snapshot": "node scripts/build-static-snapshot.mjs --serve --out out-static",
    "review:apply": "node scripts/apply-review.cjs && node scripts/validate-data.cjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
